# Listing of Parameters
# ---------------------
#################################################################################
# Global Grid and Discretization 

set dim          = 2
set refinements  = 4

#initial grid for 2D is m x n or 3D m x n x l, enter below m, n or m, n, l

set initial_grid_2D  = 3, 2
set initial_grid_3D  = 1, 1, 1

set initial_refinement_2D = 5, 1 | 5, 1 | 5, 1 ; 5, 4 | 5, 4 | 5, 4
set initial_refinement_3D = 1, 1, 1

set initial_refinement_mortar_2D = 5, 1 | 5, 1 | 5, 1 ; 5, 4 | 5, 4 | 5, 4

# Enter which subdomain are for Stokes and Biot
# 1 for Stokes and 2 for Biot
# Note: Total subdomains should equal number of processes for mpirun
set grid = 1, 1, 1; 1, 2, 1


#################################################################################
# Stokes Parameters
# Enter Finite elemet, quadrature and mortar information for Stokes

subsection Stokes Parameters
    set degree                = 1
    set quad_degree           = 5
	set continuous_mortar     = yes
	set stokes_mortar_degree  = 2
	set gamma                 = 100.0
	set viscosity             = 1.81e-8
	set initial_val lambda    = 0.0
	set multiscale_basis      = no
end

#################################################################################
# Biot Parameters
# Enter Finite elemet, quadrature and mortar information for Biot

subsection Biot Parameters
    set degree              = 1
    set quad_degree         = 5
	set mortar_type         = 0
	set mortar_degree       = 1
	set viscosity           = 1.81e-8
	set s_0                 = 7e-2
	set alpha               = 1.0
	set alpha_BJS           = 1.0
	set lame_mu             = 1e+2
	set lame_lambda         = 1e+3
	set K                   = 0.505e-6, 0.495e-6; 0.495e-6, 0.505e-6
	set initial_val lambda  = 0.0
	set multiscale_basis    = no
end

#################################################################################
# Boundary condition enforcement for external Boundaries
# (D for Dirichlet and N for Neumann)
# Faces: {bottom, right, top, left, out of plane, inside plane}
# Example 2D: N, D, N, D represents bottom and top Neumann and other 
# 2 sides Dirichlet
# For Biot we have three flavors of neumann Conditions, choose appropriately
# S: Neumann stress + pressure dirichlet 
# V: Neumann Darcy velocity + displacement
# N: Neumann stress + Neumann Darcy velocity

subsection External Boundary Conditions
	set boundary_2D         = D, N, D, N
	set boundary_3D         = D, D, D, D, D, D
end

#################################################################################
# Parameters for solver ('GMRES')
# Preconditioner: 0 - none, 
#                 1 - penalize S-B interface jump in mass matrix M_i
#                 2 - Jacobi
#                 3 - Scales only dirichlet dofs in stokes
#                 4 - scales disp dofs by 2*(lambda+mu) and press dofs by K at s-b and b-b interface
#                 5 - scales each interface by constant (||Mr||/||r||)^2 where r is 1 on the interface and 0 ow
#                 6 - scales each interface by constant (||Mr||/||r||) where r is 1 on the interface and 0 ow
#                 7 - same as 5 but has exp(log_10((||Mr||/||r||)^2)) for each dof
#                 8 - still in development will scale as 6 but 5-6 types of dofs on an interface

subsection Solver
	set max_iter             = 1000
	set tol                  = 1e-8
	set preconditioner_type  = 0
end
